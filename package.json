		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"typescript-eslint": "8.70.0",
		"vite": "8.3.0",
		"wrangler": "4.131.1"
	},
	"dependencies": {
		"@lucide/svelte": "1.45.0"
	}
